# Zkopírujte jako .env.local a doplňte hodnoty. .env.local NIKDY nepatří do gitu.

# ============================================================================
# SQL Server (docs/NASAZENI.md) - cílové prostředí po přesunu ze Supabase
# ============================================================================
MSSQL_SERVER=localhost
# Buď port, nebo pojmenovaná instance - ne obojí.
MSSQL_PORT=1433
# MSSQL_INSTANCE=SQLEXPRESS
MSSQL_DATABASE=Udrzba
# 'ano' = věřit i vlastnoručně podepsanému certifikátu serveru (lokální vývoj),
# 'ne'  = certifikát ověřovat (ostrý server s certifikátem od IT).
MSSQL_TRUST_CERT=ano

# Účet aplikace: má jen práva z migrace a RLS ho omezuje. Čte ho src/lib/env.ts.
MSSQL_APP_USER=udrzba_app
MSSQL_APP_PASSWORD=<heslo>

# Účet pro migrace, seed a testy: vlastník databáze. Jen skripty npm run mssql:*.
MSSQL_MIGRACE_USER=udrzba_migrace
MSSQL_MIGRACE_PASSWORD=<heslo>

# Účet nočního plánovače: smí jen EXEC dbo.spust_planovac.
MSSQL_PLANOVAC_USER=udrzba_planovac
MSSQL_PLANOVAC_PASSWORD=<heslo>

# Jen pro `npm run mssql:init` na LOKÁLNÍM serveru (zakládá databázi a loginy).
# Na serveru od IT se nepoužívá.
# MSSQL_ADMIN_USER=sa
# MSSQL_ADMIN_PASSWORD=<heslo>

# `npm run mssql:reset` maže všechna data. Mimo localhost běží jen s tímhle souhlasem.
# MSSQL_POVOLIT_RESET=ano

# ============================================================================
# Aplikace
# ============================================================================
# Podpis relační cookie: aspoň 32 náhodných znaků. Kdo ho zná, vydá si libovolnou
# identitu - patří výhradně na server, nikdy do gitu ani do chatu.
RELACE_TAJEMSTVI=<32+ nahodnych znaku>
# Jak dlouho platí přihlášení bez činnosti (hodiny).
RELACE_PLATNOST_H=12
# Přílohy a fotky. Adresář musí být v zálohách (docs/PROVOZ.md).
SOUBORY_ADRESAR=./data/soubory

# ============================================================================
# Testy a seed
# ============================================================================
# Heslo testovacích účtů ze seedu (README, Testovací účty).
SEED_HESLO=Senco.Test123
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ============================================================================
# Průzkum ZAKMATu - scripts/prozkoumej-mssql.mjs, jen čte
# (npm run mssql:prozkoumej -- --databaze=ZAKMAT)
# ============================================================================
# MSSQL_USER=<sql-prihlaseni>
# MSSQL_PASSWORD=<heslo>
# MSSQL_DOMAIN=FIRMA

# ============================================================================
# Supabase - dnešní vývojové prostředí, platí do dokončení přesunu (kolo R8)
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-klic>
# TAJNÉ. Obchází Row Level Security. Používá se VÝHRADNĚ v scripts/seed-users.mjs.
SUPABASE_SERVICE_ROLE_KEY=<service-role-klic>
