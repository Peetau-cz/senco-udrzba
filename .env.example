# Zkopírujte jako .env.local a doplňte hodnoty z Supabase → Project Settings → API.
# .env.local NIKDY nepatří do gitu.

# Veřejné hodnoty — posílají se do prohlížeče, to je v pořádku.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-klic>

# TAJNÉ. Obchází Row Level Security a vidí na všechna data.
# Používá se VÝHRADNĚ v lokálním skriptu scripts/seed-users.mjs.
# Nikdy jej nepoužívejte v kódu pod src/ a nikdy jej nikam nenahrávejte.
SUPABASE_SERVICE_ROLE_KEY=<service-role-klic>

# Základní adresa aplikace pro Playwright testy.
PLAYWRIGHT_BASE_URL=http://localhost:3000
